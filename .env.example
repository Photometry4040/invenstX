# InvenstX Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control

# API Keys (Optional - for enhanced features)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
NEWS_API_KEY=your_news_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///invenstx.db
# For PostgreSQL: postgresql://user:password@localhost:5432/invenstx
# For MySQL: mysql://user:password@localhost:3306/invenstx

# Redis Configuration (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_random_secret_key_in_production
JWT_SECRET=change_this_to_random_jwt_secret_in_production

# Application Settings
DEBUG=false
LOG_LEVEL=info
TIMEZONE=Asia/Seoul

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Feature Flags
ENABLE_PAPER_TRADING=true
ENABLE_ENSEMBLE_MODELS=true
ENABLE_REALTIME_DATA=false
ENABLE_GPU_ACCELERATION=false
ENABLE_NEWS_SENTIMENT=false

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_DATA_POINTS=5000
MAX_BACKTEST_DAYS=365

# Model Settings
DEFAULT_EPOCHS=50
DEFAULT_BATCH_SIZE=32
DEFAULT_LEARNING_RATE=0.001
MODEL_SAVE_FREQUENCY=10

# Data Settings
DATA_UPDATE_FREQUENCY=daily
CACHE_EXPIRY_HOURS=24
MAX_CACHE_SIZE_MB=1000

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here
GOOGLE_ANALYTICS_ID=your_ga_id_here
UPTIMEROBOT_API_KEY=your_uptimerobot_key_here

# Notification Settings (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=invenstx-models
AWS_REGION=us-east-1

# External Services (Optional)
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets